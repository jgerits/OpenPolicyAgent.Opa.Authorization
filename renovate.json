{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 5am on monday"
  ],
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "auto",
  "platformAutomerge": true,
  "ignoreTests": false,
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 10,
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "assignees": []
  },
  "separateMinorPatch": true,
  "separateMajorMinor": true,
  "rangeStrategy": "bump",
  "nuget": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Automerge devDependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    },
    {
      "description": "Group all non-major dependencies together",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group .NET test dependencies",
      "matchPackagePatterns": [
        "^xunit",
        "^Moq",
        "^FluentAssertions",
        "^coverlet",
        "^Microsoft\\.NET\\.Test\\.Sdk"
      ],
      "groupName": ".NET test dependencies",
      "groupSlug": "dotnet-test"
    },
    {
      "description": "Group Microsoft dependencies",
      "matchPackagePatterns": [
        "^Microsoft\\."
      ],
      "groupName": "Microsoft dependencies",
      "groupSlug": "microsoft"
    }
  ]
}